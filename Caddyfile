# Replace sndbnk.com with your real domain before deploying.
#
# Tenant hosting:
# - Apex + www: managed certificates (below)
# - Premium subdomains (*.sndbnk.com) and verified custom domains: on-demand TLS
#   gated by /api/domain-tls-check so random hosts cannot obtain certificates.
# - DNS: point apex and *.sndbnk.com A records at this server (wildcard is required).
#   Custom domains CNAME to {username}.sndbnk.com, or A/AAAA/ALIAS to the same IPs,
#   after the user verifies in Settings.

{
	on_demand_tls {
		ask http://127.0.0.1:3000/api/domain-tls-check
	}
}

www.sndbnk.com {
	redir https://sndbnk.com{uri} permanent
}

sndbnk.com {
	encode gzip zstd

	log {
		output file /var/log/caddy/sndbnk.access.log
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		# Report-Only until Butterchurn / Stripe / fonts are fully inventory'd in prod.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.stripe.com https://*.stripe.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com"
		-Server
	}

	# Bun/SvelteKit serves the app and static assets
	reverse_proxy localhost:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

# Catch-all HTTPS for premium subdomains and verified custom domains.
https:// {
	tls {
		on_demand
	}

	encode gzip zstd

	log {
		output file /var/log/caddy/sndbnk-tenant.access.log
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.stripe.com https://*.stripe.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com"
		-Server
	}

	reverse_proxy localhost:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
