# Drizzle (relative paths are resolved from the app working directory)
DATABASE_URL=local.db

# App origin used by better-auth (must match the browser origin exactly)
# Dev: http://localhost:5174
# Prod: https://sndbnk.com
ORIGIN=http://localhost:5174

# Apex hostname for path/subdomain tenant URLs (no protocol)
# Dev: localhost  → test subdomains as username.localhost:5174
# Prod: sndbnk.com
PUBLIC_BASE_DOMAIN=localhost

# Behind Caddy/Lightsail these help the Bun adapter reconstruct request URLs.
# PROTOCOL_HEADER=X-Forwarded-Proto
# HOST_HEADER=X-Forwarded-Host

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Local media uploads root (gitignored). Relative paths resolve from the app cwd.
MEDIA_ROOT=./media

# svelte-adapter-bun / Bun max request body (default 512K is too small for uploads).
# Must be >= audio max (100MB) + cover max (5MB) + form overhead.
BODY_SIZE_LIMIT=110M

# Encrypts SSH / BYOS credentials stored in the DB. Use 32+ characters with high entropy.
STORAGE_SECRET=""

# ---------------------------------------------------------------------------
# Billing and mail. Every variable below is optional; billing routes report a
# clear error while STRIPE_SECRET_KEY is empty, and mail falls back to stdout.
#
# Put the real values in `.env.local`, never here or in `.env` — both of those
# are tracked in git. `.env.*` is gitignored and Vite loads it at higher
# precedence.
# ---------------------------------------------------------------------------

# Prefer a restricted key (rk_...) over a secret key (sk_...).
# Dev: the SNDBNK sandbox's rk_test_/sk_test_ key. Prod: the live key.
STRIPE_SECRET_KEY=""
PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Signing secret for /api/stripe/webhook.
# Dev: run `stripe listen --forward-to localhost:5174/api/stripe/webhook`.
# Prod: read it off the webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=""

# `console` writes mail to stdout (dev); `smtp` sends through the server below.
MAIL_TRANSPORT=console
MAIL_FROM="SNDBNK <no-reply@sndbnk.com>"

# Only read when MAIL_TRANSPORT=smtp. SMTP_SECURE=true means implicit TLS (port 465).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
